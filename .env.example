# Copiez en .env et remplissez. Générer un token : openssl rand -hex 32
EXEC_API_TOKEN=remplacez_par_votre_token_secret

# Optionnel (défauts sûrs) :
# EXEC_API_HOST=0.0.0.0       # conteneur derrière reverse proxy
# EXEC_API_PORT=5555
# EXEC_API_TIMEOUT=30
# EXEC_API_MAXOUT=100000
# EXEC_API_CWD=/home/user
